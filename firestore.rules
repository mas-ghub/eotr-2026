// End of the Road 2026 — Chat security rules.
// Paste this whole file into Firebase console →
// Firestore Database → Rules, then Publish.
//
// Design:
//  - Public wall (`messages`): anyone may read; posting requires the anonymous
//    identity and the senderId is forced to match it. Nothing editable/deletable.
//  - Private chats (`conversations` + their `messages` subcollection): only
//    participants can read/create, enforced via request.auth.uid membership.
//  - Requires Firebase Authentication → Anonymous sign-in to be ENABLED
//    (console → Authentication → Sign-in method → Anonymous → Enable).
//  - Sizes are capped and `ts` is only ever set by the server (serverTimestamp).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMessage(doc) {
      return doc.data.name is string
        && doc.data.name.size() >= 1
        && doc.data.name.size() <= 24
        && doc.data.text is string
        && doc.data.text.size() >= 1
        && doc.data.text.size() <= 280
        && doc.data.ts is timestamp;
    }

    // Public guestbook wall
    match /messages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null
        && isMessage(request.resource)
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    // Conversations: only participants may read or create
    match /conversations/{convId} {
      // resource == null covers reading a doc that doesn't exist yet (e.g. when
      // checking whether a DM exists before creating it) — that must not be denied.
      allow read: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if request.auth != null
        && request.resource.data.type is string
        && request.resource.data.type in ['dm', 'group']
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 20
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants
          && isMessage(request.resource)
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
