// End of the Road 2026 — Chat guestbook security rules.
// Paste this whole file into Firebase console →
// Firestore Database → Rules, then Publish.
//
// Design: a public, anonymous guestbook. Anyone may read every message and
// create a new one, but existing messages can never be edited or deleted
// (so the wall can't be rewritten/taken over). Writes are size-capped and
// type-checked. `ts` is only ever set by the server (serverTimestamp).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /messages/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 24
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 280;
      allow update, delete: if false;
    }
  }
}
