// End of the Road 2026 — Chat security rules.
// Paste this whole file into Firebase console →
// Firestore Database → Rules, then Publish.
//
// Design:
//  - Public wall (`messages`): anyone may read; posting requires the anonymous
//    identity and the senderId is forced to match it. Nothing editable/deletable.
//  - Private chats (`conversations` + their `messages` subcollection): only
//    participants can read/create, enforced via request.auth.uid membership.
//  - Requires Firebase Authentication → Anonymous sign-in to be ENABLED
//    (console → Authentication → Sign-in method → Anonymous → Enable).
//  - Sizes are capped and `ts` is only ever set by the server (serverTimestamp).
//  - The `devtest_*` collections are EXACT mirror rules so the automated e2e
//    suites can run against isolated data (VITE_FIRESTORE_PREFIX=devtest_) and
//    never touch the live app collections.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMessage(doc) {
      return doc.data.name is string
        && doc.data.name.size() >= 1
        && doc.data.name.size() <= 24
        && doc.data.text is string
        && doc.data.text.size() >= 1
        && doc.data.text.size() <= 280
        && doc.data.ts is timestamp;
    }

    // Public guestbook wall
    match /messages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null
        && isMessage(request.resource)
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    // Unique display names — first come, first served. Doc id = lowercased name.
    // create only succeeds if the name isn't taken yet (atomic). The owner may
    // update their own claim (e.g. re-enter or change casing); nobody can delete.
    match /names/{nameId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 24;
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/names/$(nameId)).data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 24;
      allow delete: if false;
    }

    // Presence ("who's online") — any signed-in visitor can see it; each device
    // only writes its own doc. `online` flips false on disconnect.
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 24;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Shared locations — read by any signed-in visitor, written ONLY by the
    // device that owns the uid. Values validated so nothing bogus lands.
    match /locations/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 24
        && request.resource.data.lat is number
        && request.resource.data.lat >= -90
        && request.resource.data.lat <= 90
        && request.resource.data.lng is number
        && request.resource.data.lng >= -180
        && request.resource.data.lng <= 180
        && request.resource.data.accuracy is number
        && request.resource.data.accuracy >= 0;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Conversations: only participants may read or create
    match /conversations/{convId} {
      // resource == null covers reading a doc that doesn't exist yet (e.g. when
      // checking whether a DM exists before creating it) — that must not be denied.
      allow read: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if request.auth != null
        && request.resource.data.type is string
        && request.resource.data.type in ['dm', 'group']
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 20
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants
          && isMessage(request.resource)
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ================================================================
    // Isolated e2e mirrors (devtest_ prefix) — same rules as above.
    // ================================================================

    match /devtest_messages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null
        && isMessage(request.resource)
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    match /devtest_names/{nameId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 24;
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/devtest_names/$(nameId)).data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 24;
      allow delete: if false;
    }

    match /devtest_presence/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 24;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /devtest_locations/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 24
        && request.resource.data.lat is number
        && request.resource.data.lat >= -90
        && request.resource.data.lat <= 90
        && request.resource.data.lng is number
        && request.resource.data.lng >= -180
        && request.resource.data.lng <= 180
        && request.resource.data.accuracy is number
        && request.resource.data.accuracy >= 0;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /devtest_conversations/{convId} {
      allow read: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if request.auth != null
        && request.resource.data.type is string
        && request.resource.data.type in ['dm', 'group']
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 20
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/devtest_conversations/$(convId)).data.participants;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/devtest_conversations/$(convId)).data.participants
          && isMessage(request.resource)
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
