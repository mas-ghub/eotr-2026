# Firebase config for the shared Chat / guestbook.
# Copy this file to app/.env and fill in your own values (see plan.md "Chat setup").
# These keys come from Firebase console → Project settings → General → Your apps →
# SDK setup and configuration. They are PUBLIC by design (Firebase web API keys
# are not secrets) — the Firestore security rules are what protect the data.
#
# You only strictly need API_KEY and PROJECT_ID for the chat to work; the rest
# keep the SDK happy if you add auth later.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push (FCM) — optional. Enables reminders to fire when the app is closed
# (needed on iOS). Get the key from Firebase console → Project settings →
# Cloud Messaging → Web push certificates → Key pair. The sender also needs a
# service account added as the FIREBASE_SERVICE_ACCOUNT GitHub secret — see
# plan.md §4 "Web Push reminders" for the full setup.
VITE_FIREBASE_VAPID_KEY=
